@model IEnumerable<Supplier>
@{ViewData["Title"]="Proveedores";}
<div class="page-heading"><h1>Proveedores</h1><a class="primary" asp-action="Create">Nuevo proveedor</a></div>
<form class="filters" method="get"><input name="search" value="@ViewBag.Search" placeholder="Nombre o NIF/CIF"/><select name="active"><option value="">Todos</option><option value="true">Activos</option><option value="false">Inactivos</option></select><button>Buscar</button></form>
<div class="table-wrap"><table><thead><tr><th>Nombre</th><th>NIF/CIF</th><th>Correo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.TaxId</td><td>@x.Email</td><td>@(x.IsActive?"Activo":"Inactivo")</td><td><a asp-action="Details" asp-route-id="@x.Id">Ver</a></td></tr>}</tbody></table></div>