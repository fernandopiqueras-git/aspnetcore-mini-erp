@model IReadOnlyCollection<Supplier>
@{
    ViewData["Title"] = "Proveedores";
}
<div class="page-heading">
    <div>
        <span class="eyebrow">MAESTROS</span>
        <h1>Proveedores</h1>
    </div>
    <a class="primary" asp-action="Create">Nuevo proveedor</a>
</div>

<form method="get" class="filters">
    <input name="search" value="@ViewBag.Search" placeholder="Buscar por nombre o NIF/CIF" />
    <select name="active">
        <option value="">Todos</option>
        <option value="true" selected="@(ViewBag.Active is true ? "selected" : null)">Activos</option>
        <option value="false" selected="@(ViewBag.Active is false ? "selected" : null)">Inactivos</option>
    </select>
    <button>Filtrar</button>
    <a asp-action="Index">Limpiar</a>
</form>

<section class="panel">
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>NIF/CIF</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td><strong>@supplier.Name</strong></td>
                        <td>@supplier.TaxId</td>
                        <td>@supplier.Email</td>
                        <td>@supplier.Phone</td>
                        <td>
                            <span class="status @(supplier.IsActive ? "active" : "inactive")">
                                @(supplier.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="row-actions">
                            <a asp-action="Details" asp-route-id="@supplier.Id">Ver</a>
                            <a asp-action="Edit" asp-route-id="@supplier.Id">Editar</a>
                            <a class="danger" asp-action="Delete" asp-route-id="@supplier.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
