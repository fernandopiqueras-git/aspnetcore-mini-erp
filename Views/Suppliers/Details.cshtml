@model Supplier
@{ViewData["Title"]=Model.Name;}<div class="page-heading"><h1>@Model.Name</h1><span class="badge">@(Model.IsActive?"Activo":"Inactivo")</span></div>@if(TempData["Error"] is string e){<div class="validation">@e</div>}<div class="details"><dl><dt>NIF/CIF</dt><dd>@Model.TaxId</dd><dt>Correo</dt><dd>@Model.Email</dd><dt>Teléfono</dt><dd>@Model.Phone</dd><dt>Dirección</dt><dd>@Model.Address</dd></dl></div><div class="actions"><a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a><a asp-action="Index">Volver</a></div>