@model IEnumerable<StockMovement>
@{ViewData["Title"]="Movimientos";}<div class="page-heading"><h1>Movimientos de stock</h1><a class="primary" asp-action="Create">Nuevo movimiento</a></div><form class="filters" method="get"><select name="productId" asp-items="ViewBag.Products"><option value="">Todos los artículos</option></select><select name="warehouseId" asp-items="ViewBag.Warehouses"><option value="">Todos los almacenes</option></select><button>Filtrar</button></form><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Tipo</th><th>Artículo</th><th>Origen</th><th>Destino</th><th>Cantidad</th><th>Referencia</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@x.Type</td><td>@x.Product.Name</td><td>@x.SourceWarehouse?.Name</td><td>@x.DestinationWarehouse?.Name</td><td>@x.Quantity.ToString("N3")</td><td>@x.Reference</td></tr>}</tbody></table></div>