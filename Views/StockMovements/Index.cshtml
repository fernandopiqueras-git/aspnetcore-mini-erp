@model IReadOnlyCollection<StockMovement>
@{
    ViewData["Title"] = "Movimientos de stock";
    var purchaseOrderReferences = (IReadOnlySet<string>)ViewBag.PurchaseOrderReferences;
    var salesOrderReferences = (IReadOnlySet<string>)ViewBag.SalesOrderReferences;

    string MovementType(StockMovement movement) => movement.Type switch
    {
        StockMovementType.Entry => "Entrada",
        StockMovementType.Exit => "Salida",
        StockMovementType.Transfer => "Transferencia",
        StockMovementType.Adjustment => "Regularización",
        _ => movement.Type.ToString()
    };

    string MovementOrigin(StockMovement movement) => movement.Type switch
    {
        StockMovementType.Entry when purchaseOrderReferences.Contains(movement.Reference) => $"Pedido de compra {movement.Reference}",
        StockMovementType.Entry => "Entrada manual",
        StockMovementType.Adjustment => "Regularización manual",
        _ => movement.SourceWarehouse?.Name ?? "Origen no disponible"
    };

    string MovementDestination(StockMovement movement) => movement.Type switch
    {
        StockMovementType.Exit when salesOrderReferences.Contains(movement.Reference) => $"Pedido de venta {movement.Reference}",
        StockMovementType.Exit => "Salida manual",
        _ => movement.DestinationWarehouse?.Name ?? "Destino no disponible"
    };
}
<div class="page-heading">
    <div>
        <span class="eyebrow">ALMACÉN</span>
        <h1>Movimientos de stock</h1>
    </div>
    <a class="primary" asp-action="Create" asp-route-type="@StockMovementType.Entry">Entrada manual</a>
</div>

<form method="get" class="filters">
    <select name="productId" asp-items="ViewBag.Products">
        <option value="">Todos los artículos</option>
    </select>
    <select name="warehouseId" asp-items="ViewBag.Warehouses">
        <option value="">Todos los almacenes</option>
    </select>
    <button>Filtrar</button>
    <a asp-action="Index">Limpiar</a>
</form>

<section class="panel">
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Artículo</th>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Cantidad</th>
                    <th>Referencia</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movement in Model)
                {
                    <tr>
                        <td>@movement.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@MovementType(movement)</td>
                        <td>@movement.Product.Name</td>
                        <td>@MovementOrigin(movement)</td>
                        <td>@MovementDestination(movement)</td>
                        <td>@movement.Quantity.ToString("N3")</td>
                        <td>@movement.Reference</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
