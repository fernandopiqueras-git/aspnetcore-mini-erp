@model PurchaseOrder
@{ViewData["Title"]=$"Compra {Model.Number}";}<div class="page-heading"><h1>@Model.Number</h1><span class="badge">@Model.Status</span></div><div class="detail-grid"><div><strong>Proveedor</strong><p>@Model.Supplier.Name</p></div><div><strong>Fecha</strong><p>@Model.OrderDate.ToString("dd/MM/yyyy")</p></div><div><strong>Total</strong><p>@Model.Total.ToString("N2") €</p></div></div><div class="table-wrap"><table><thead><tr><th>Artículo</th><th>Cantidad</th><th>Precio</th><th>Dto.</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Lines){<tr><td>@x.Product.Name</td><td>@x.Quantity</td><td>@x.UnitPrice.ToString("N2") €</td><td>@x.DiscountPercentage %</td><td>@x.LineTotal.ToString("N2") €</td></tr>}</tbody></table></div><div class="actions">@if(Model.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Confirmed){<a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>}@if(Model.Status==PurchaseOrderStatus.Draft){<form method="post" asp-action="Confirm" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<button>Confirmar</button></form>}@if(Model.Status==PurchaseOrderStatus.Confirmed){<form method="post" asp-action="Receive" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<button>Recibir</button></form>}@if(Model.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Confirmed){<form method="post" asp-action="Cancel" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<button class="danger">Cancelar</button></form>}<a asp-action="Index">Volver</a></div>