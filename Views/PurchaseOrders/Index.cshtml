@model IEnumerable<PurchaseOrder>
@{ViewData["Title"]="Compras";}<div class="page-heading"><h1>Pedidos de compra</h1><a class="primary" asp-action="Create">Nueva compra</a></div><form class="filters" method="get"><input name="search" value="@ViewBag.Search" placeholder="Número o proveedor"/><select name="status"><option value="">Todos</option>@foreach(var s in Enum.GetValues<PurchaseOrderStatus>()){<option value="@s">@s</option>}</select><button>Buscar</button></form><div class="table-wrap"><table><thead><tr><th>Número</th><th>Fecha</th><th>Proveedor</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Number</td><td>@x.OrderDate.ToString("d")</td><td>@x.Supplier.Name</td><td>@x.Status</td><td>@x.Total.ToString("N2") €</td><td><a asp-action="Details" asp-route-id="@x.Id">Ver</a></td></tr>}</tbody></table></div>