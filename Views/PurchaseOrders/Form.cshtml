@model PurchaseOrderFormViewModel
@{ViewData["Title"]=Model.Id==0?"Nueva compra":"Editar compra";var products=(IEnumerable<Product>)ViewBag.Products;var c=System.Globalization.CultureInfo.InvariantCulture;}
<h1>@ViewData["Title"]</h1><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Número<input asp-for="Number"/></label><label>Fecha<input asp-for="OrderDate" type="date"/></label><label>Proveedor<select asp-for="SupplierId" asp-items="ViewBag.Suppliers"><option value="">Selecciona</option></select></label><label>Almacén<select asp-for="WarehouseId" asp-items="ViewBag.Warehouses"><option value="">Selecciona</option></select></label><label>Estado<select asp-for="Status" asp-items="Html.GetEnumSelectList<PurchaseOrderStatus>()"></select></label></div><h2>Líneas</h2><div class="table-wrap"><table id="lines"><thead><tr><th>Artículo</th><th>Cantidad</th><th>Precio</th><th>Dto.%</th><th></th></tr></thead><tbody>@for(var i=0;i<Model.Lines.Count;i++){<tr><td><select name="Lines[@i].ProductId" data-field="ProductId" class="product"><option value="">Selecciona</option>@foreach(var p in products){<option value="@p.Id" selected="@(p.Id==Model.Lines[i].ProductId)" data-price="@p.UnitPrice.ToString(c)">@p.Name</option>}</select></td><td><input name="Lines[@i].Quantity" data-field="Quantity" type="number" min=".001" step=".001" value="@Model.Lines[i].Quantity.ToString(c)"/></td><td><input name="Lines[@i].UnitPrice" data-field="UnitPrice" class="price" type="number" min="0" step=".01" value="@Model.Lines[i].UnitPrice.ToString(c)"/></td><td><input name="Lines[@i].DiscountPercentage" data-field="DiscountPercentage" type="number" min="0" max="100" step=".01" value="@Model.Lines[i].DiscountPercentage.ToString(c)"/></td><td><button type="button" class="remove secondary">Quitar</button></td></tr>}</tbody></table></div><button type="button" id="add" class="secondary">Añadir línea</button><div class="actions"><button>Guardar</button><a asp-action="Index">Cancelar</a></div></form><template id="tpl"><tr><td><select data-field="ProductId" class="product"><option value="">Selecciona</option>@foreach(var p in products){<option value="@p.Id" data-price="@p.UnitPrice.ToString(c)">@p.Name</option>}</select></td><td><input data-field="Quantity" type="number" min=".001" step=".001" value="1"/></td><td><input data-field="UnitPrice" class="price" type="number" min="0" step=".01" value="0"/></td><td><input data-field="DiscountPercentage" type="number" min="0" max="100" step=".01" value="0"/></td><td><button type="button" class="remove secondary">Quitar</button></td></tr></template><script>const b=document.querySelector("#lines tbody");function rename(){[...b.rows].forEach((r,i)=>r.querySelectorAll("[data-field]").forEach(f=>f.name="Lines["+i+"]."+f.dataset.field));}document.querySelector("#add").onclick=()=>{b.append(document.querySelector("#tpl").content.cloneNode(true));rename();};b.onclick=e=>{if(e.target.classList.contains("remove")&&b.rows.length>1){e.target.closest("tr").remove();rename();}};b.onchange=e=>{if(e.target.classList.contains("product"))e.target.closest("tr").querySelector(".price").value=e.target.selectedOptions[0].dataset.price||0;};rename();</script>