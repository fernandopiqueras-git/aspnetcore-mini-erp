<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Mini ERP</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">Mini ERP</a>
    <div><a asp-controller="Home" asp-action="Index">Panel</a><a asp-controller="Customers" asp-action="Index">Clientes</a><a asp-controller="Products" asp-action="Index">Artículos</a><a asp-controller="SalesOrders" asp-action="Index">Ventas</a><a asp-controller="Suppliers" asp-action="Index">Proveedores</a><a asp-controller="PurchaseOrders" asp-action="Index">Compras</a><a asp-controller="Warehouses" asp-action="Index">Almacenes</a><a asp-controller="StockMovements" asp-action="Index">Movimientos</a></div>
</nav>
<main class="container">@RenderBody()</main>
</body>
</html>