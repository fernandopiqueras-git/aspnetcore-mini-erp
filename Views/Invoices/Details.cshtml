@model Invoice
@{ViewData["Title"]=$"{Model.Series}-{Model.Number}";}<div class="page-heading"><h1>@Model.Series-@Model.Number</h1><span class="badge">@Model.Status</span></div><div class="detail-grid"><div><strong>Base</strong><p>@Model.TaxBase.ToString("N2") €</p></div><div><strong>Impuestos (@Model.TaxRate %)</strong><p>@Model.TaxAmount.ToString("N2") €</p></div><div><strong>Total</strong><p>@Model.Total.ToString("N2") €</p></div></div><h2>Cobros/Pagos</h2><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Método</th><th>Importe</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.Date.ToString("d")</td><td>@p.Method</td><td>@p.Amount.ToString("N2") €</td></tr>}</tbody></table></div><div class="actions">@if(Model.Status==InvoiceStatus.Draft){<form asp-action="Issue" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button>Emitir</button></form>}@if(Model.Status==InvoiceStatus.Issued){<form asp-action="Pay" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input name="amount" type="number" min=".01" step=".01" max="@Model.Outstanding" required/><input name="method" value="Transferencia" maxlength="80" required/><button>Registrar pago</button></form>}@if(Model.Payments.Count==0&&(Model.Status is InvoiceStatus.Draft or InvoiceStatus.Issued)){<form asp-action="Cancel" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="danger">Cancelar factura</button></form>}<a asp-action="Index">Volver</a></div>