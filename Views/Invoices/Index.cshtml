@model IEnumerable<Invoice>@{ViewData["Title"]="Facturación";}<div class="page-heading"><h1>Facturación</h1></div><div class="table-wrap"><table><thead><tr><th>Factura</th><th>Tipo</th><th>Fecha</th><th>Vencimiento</th><th>Estado</th><th>Total</th><th>Pendiente</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Series-@x.Number</td><td>@x.Type</td><td>@x.IssueDate.ToString("dd/MM/yyyy")</td><td>@x.DueDate.ToString("dd/MM/yyyy")</td><td>@x.Status</td><td>@x.Total.ToString("N2") €</td><td>@x.Outstanding.ToString("N2") €</td><td><a asp-action="Details" asp-route-id="@x.Id">Ver</a></td></tr>}</tbody></table></div>