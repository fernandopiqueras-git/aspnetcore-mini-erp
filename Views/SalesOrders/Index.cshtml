@model IEnumerable<SalesOrder>
@{
    ViewData["Title"] = "Pedidos";
}
<div class="page-heading"><div><p class="eyebrow">Ventas</p><h1>Pedidos</h1></div><a class="button" asp-action="Create">Nuevo pedido</a></div>
@if (TempData["Error"] is string error) { <div class="validation-summary">@error</div> }
<form method="get" class="filters">
    <input name="search" value="@ViewBag.Search" placeholder="Número o cliente" />
    <select name="status"><option value="">Todos los estados</option>@foreach (var status in Enum.GetValues<SalesOrderStatus>()) { <option value="@status" selected="@(ViewBag.Status?.ToString() == status.ToString())">@status</option> }</select>
    <button type="submit">Buscar</button>
</form>
<div class="table-wrap"><table><thead><tr><th>Número</th><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>
@foreach (var order in Model) {
<tr><td>@order.Number</td><td>@order.OrderDate.ToString("d")</td><td>@order.Customer.Name</td><td><span class="badge">@order.Status</span></td><td>@order.Total.ToString("N2") €</td><td><a asp-action="Details" asp-route-id="@order.Id">Ver</a></td></tr>
}
</tbody></table></div>