@model SalesOrder
@{
    ViewData["Title"] = $"Pedido {Model.Number}";
}
<div class="page-heading"><div><p class="eyebrow">Pedido</p><h1>@Model.Number</h1></div><span class="badge">@Model.Status</span></div>
@if (TempData["Error"] is string error) { <div class="validation-summary">@error</div> }
<div class="detail-grid"><div><strong>Cliente</strong><p>@Model.Customer.Name</p></div><div><strong>Fecha</strong><p>@Model.OrderDate.ToString("d")</p></div><div><strong>Total</strong><p>@Model.Total.ToString("N2") €</p></div></div>
<div class="table-wrap"><table><thead><tr><th>Artículo</th><th>Cantidad</th><th>Precio</th><th>Dto.</th><th>Total</th></tr></thead><tbody>
@foreach (var line in Model.Lines) { <tr><td>@line.Product.Name</td><td>@line.Quantity.ToString("N3")</td><td>@line.UnitPrice.ToString("N2") €</td><td>@line.DiscountPercentage.ToString("N2") %</td><td>@line.LineTotal.ToString("N2") €</td></tr> }
</tbody></table></div>
<div class="actions">
@if (Model.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed) { <a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> }
@if (Model.Status == SalesOrderStatus.Draft) { <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button>Confirmar</button></form> }
@if (Model.Status == SalesOrderStatus.Confirmed) { <form asp-action="Complete" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button>Completar</button></form> }
@if (Model.Status == SalesOrderStatus.Completed) { <form asp-controller="Invoices" asp-action="FromSale" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button>Crear factura</button></form> }
@if (Model.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed) { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="danger">Cancelar pedido</button></form> }
<a asp-action="Index">Volver</a>
</div>