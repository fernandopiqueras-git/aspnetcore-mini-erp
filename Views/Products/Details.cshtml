@model Product
@{ ViewData["Title"] = "Detalle de artículo"; }
<section class="form-card details"><a asp-action="Index">← Volver a artículos</a>@if (TempData["Error"] is string error) { <div class="validation">@error</div> }<div class="page-heading"><h1>@Model.Name</h1><span class="badge @(Model.IsActive ? "active" : "inactive")">@(Model.IsActive ? "Activo" : "Inactivo")</span></div><dl><dt>SKU</dt><dd>@Model.Sku</dd><dt>Precio</dt><dd>@Model.UnitPrice.ToString("C")</dd><dt>Stock</dt><dd>@Model.Stock.ToString("N3")</dd><dt>Líneas de pedido</dt><dd>@Model.SalesOrderLines.Count</dd></dl><div class="form-actions"><a asp-action="Delete" asp-route-id="@Model.Id" class="danger">Eliminar</a><a asp-action="Edit" asp-route-id="@Model.Id" class="primary">Editar</a></div></section>
