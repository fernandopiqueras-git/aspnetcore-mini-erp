@model ChangePasswordViewModel
<h1>Cambiar contraseña</h1><div class="form-card"><form asp-action="ChangePassword" method="post" class="form-grid"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Contraseña actual<input asp-for="CurrentPassword"/></label><label>Nueva contraseña<input asp-for="NewPassword"/></label><label>Confirmar contraseña<input asp-for="ConfirmPassword"/></label><button class="button primary" type="submit">Guardar</button></form></div>
