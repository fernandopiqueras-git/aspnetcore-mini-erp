@model Customer
@{ ViewData["Title"] = "Detalle de cliente"; }
<section class="form-card details"><a asp-action="Index">← Volver a clientes</a>@if (TempData["Error"] is string error) { <div class="validation">@error</div> }<div class="page-heading"><h1>@Model.Name</h1><span class="badge @(Model.IsActive ? "active" : "inactive")">@(Model.IsActive ? "Activo" : "Inactivo")</span></div><dl><dt>NIF/CIF</dt><dd>@Model.TaxId</dd><dt>Correo</dt><dd>@(Model.Email ?? "—")</dd><dt>Teléfono</dt><dd>@(Model.Phone ?? "—")</dd><dt>Dirección</dt><dd>@(Model.Address ?? "—")</dd><dt>Pedidos</dt><dd>@Model.SalesOrders.Count</dd></dl><div class="form-actions"><a asp-action="Delete" asp-route-id="@Model.Id" class="danger">Eliminar</a><a asp-action="Edit" asp-route-id="@Model.Id" class="primary">Editar</a></div></section>
