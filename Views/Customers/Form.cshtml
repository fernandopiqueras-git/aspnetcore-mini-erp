@model Customer
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Editar cliente" : "Nuevo cliente"; }
<section class="form-card"><a asp-action="Index">← Volver a clientes</a><h1>@ViewData["Title"]</h1><form asp-action="@(editing ? "Edit" : "Create")" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation"></div><label>Nombre<input asp-for="Name" /></label><label>NIF/CIF<input asp-for="TaxId" /></label><label>Correo electrónico<input asp-for="Email" type="email" /></label><label>Teléfono<input asp-for="Phone" /></label><label>Dirección<textarea asp-for="Address"></textarea></label><label class="check"><input asp-for="IsActive" /> Cliente activo</label><div class="form-actions"><a asp-action="Index">Cancelar</a><button class="primary">Guardar</button></div></form></section>
