@model Warehouse
@{ViewData["Title"]=Model.Id==0?"Nuevo almacén":"Editar almacén";}<div class="form-card"><h1>@ViewData["Title"]</h1><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><label>Código<input asp-for="Code"/></label><label>Nombre<input asp-for="Name"/></label><label class="check"><input asp-for="IsActive"/> Activo</label><div class="form-actions"><a asp-action="Index">Cancelar</a><button class="primary">Guardar</button></div></form></div>