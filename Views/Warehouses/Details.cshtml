@model Warehouse
@{ViewData["Title"]=Model.Name;}<div class="page-heading"><h1>@Model.Name</h1><span class="badge">@Model.Code</span></div><div class="table-wrap"><table><thead><tr><th>Artículo</th><th>Existencias</th></tr></thead><tbody>@foreach(var x in Model.Stocks.OrderBy(x=>x.Product.Name)){<tr><td>@x.Product.Name</td><td>@x.Quantity.ToString("N3")</td></tr>}</tbody></table></div><div class="actions"><a class="button secondary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>@if(Model.IsActive){<form method="post" asp-action="Disable" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<button class="danger">Desactivar</button></form>}<a asp-action="Index">Volver</a></div>